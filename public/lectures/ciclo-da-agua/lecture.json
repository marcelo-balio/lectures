{
  "version": "1.0",
  "slug": "ciclo-da-agua",
  "title": "O ciclo da água",
  "author": "",
  "description": "Aula de 20 minutos sobre evaporação, condensação, precipitação e infiltração.",
  "course": "6º Ano B",
  "theme": {
    "background": "#0e3a5c",
    "foreground": "#ffffff",
    "accent": "#ffd27a",
