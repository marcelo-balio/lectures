      "y": -650.0,
      "width": 420.0,
      "scale": 1.8,
      "rotation": 0.0,
      "content": "## I. Creation\n### Culture is a calling\n*Why should culture concern me at all?*",
      "textStyle": {
        "size": 17.0,
        "weight": 400.0,
        "color": "#2b2116",
        "lineHeight": 1.38,
        "letterSpacing": 0.0,
        "align": "left"
      }
    },
    {
      "id": "s1-a-card",
      "type": "shape",
      "x": -2000.0,
      "y": -650.0,
      "width": 500.0,
      "scale": 1.0,
      "rotation": 0.0,
      "content": "",
      "shapeData": {
        "kind": "rectangle",
        "fill": "#f7edcf",
